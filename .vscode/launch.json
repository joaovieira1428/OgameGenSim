{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OgameGenSim (External Terminal)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-debug",
            "program": "${workspaceFolder}/OgameGenSim/bin/Debug/net10.0/OgameGenSim.dll",
            "args": [],
            "cwd": "${workspaceFolder}/OgameGenSim",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": false,
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/OgameGenSim/bin/Debug/net10.0",
                    "${workspaceFolder}/SimulatorPack/bin/Debug/net10.0"
                ]
            }
        },
        {
            "name": "Attach to OgameGenSim process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
        }
    ]
}