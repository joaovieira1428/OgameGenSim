{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OgameGenSim (external terminal)",
            "type": "coreclr",
            "request": "launch",
            "project": "${workspaceFolder}/OgameGenSim/OgameGenSim.csproj",
            "console": "externalTerminal",
            "stopAtEntry": false,
            "justMyCode": false,
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Attach to OgameGenSim process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false
        }
    ]
}