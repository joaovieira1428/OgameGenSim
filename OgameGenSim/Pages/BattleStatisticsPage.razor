@page "/battleStatistics"
@namespace OgameGenSim.Pages

@using OgameGenSim.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using OgameSimulatorPack.SimUtilities
@using OgameSimulatorPack.Statistics
@using RazorConsole.Components

@inject NavigationManager Nav
@inject OgameGenSim.Services.BattleStatisticsService BattleStatisticsService

<h3>BattleStatistics</h3>


@if (BattleStatisticsService.BattleStatistics != null)
{
    <FlexBox>
        <Padder Padding=(new(0,0,2,0))>
            <Border>
                <Rows>
                    <Select Options="attackerOptions.ToArray()" 
                    Value="_selectedAttackingPlayer" 
                    ValueChanged="@((string? value) => OnAttackerSelectChange(value))"></Select>

                    <Grid Expand="true" Columns="3">
                    
                            <BattleStatisticsItem 
                            GlobalPlayerAmount="BattleStatisticsService.BattleStatistics.GlobalAttackersAmount"
                            LostPlayerAmount="lostAttacker"></BattleStatisticsItem>
                
                    </Grid>
                </Rows>
            </Border>
        </Padder> 
        <Padder Padding=(new(2,0,0,0))>
            <Border>
                <Rows>
                    <Select Options="defenderOptions.ToArray()" 
                    Value="_selectedDefendingPlayer" 
                    ValueChanged="@((string? value) => OnDefenderSelectChange(value))"></Select>

                    <Grid Expand="true" Columns="3">
                    
                            <BattleStatisticsItem 
                            GlobalPlayerAmount="BattleStatisticsService.BattleStatistics.GlobalDefendersAmount"
                            LostPlayerAmount="lostDefender"></BattleStatisticsItem>
                
                    </Grid>
                </Rows>
            </Border>
        </Padder>
    </FlexBox>
}
else
{
    <p>No battle statistics available.</p>
}



@code {
    private Dictionary<UnitType, int> attackerAmount = [];
    private Dictionary<UnitType, int> defenderAmount = [];
    private Dictionary<UnitType, int> lostAttacker = [];
    private Dictionary<UnitType, int> lostDefender = [];

    private List<string> attackerOptions = [];
    private List<string> defenderOptions = [];

    private string _selectedAttackingPlayer = string.Empty;
    private string _selectedDefendingPlayer = string.Empty;
    protected override void OnInitialized()
    {
        if (BattleStatisticsService.BattleStatistics != null)
        {
            PopulateUnits();
            attackerOptions.Add("All");
            attackerOptions.AddRange(BattleStatisticsService.BattleStatistics.Attackers.Select(x=> x.Coordinates));
            _selectedAttackingPlayer = "All";

            defenderOptions.Add("All");
            defenderOptions.AddRange(BattleStatisticsService.BattleStatistics.Defenders.Select(x=> x.Coordinates));
            _selectedDefendingPlayer = "All";
        }
    }

    private void PopulateUnits()
    {
        if (BattleStatisticsService.BattleStatistics == null) return;

        lostAttacker = [];
        lostDefender = [];

        foreach (var round in BattleStatisticsService.BattleStatistics.RoundStatistics)
        {
            foreach (var kvp in round.AttackersRoundStatistics.GlobalUnitLostAmount)
            {
                if (lostAttacker.ContainsKey(kvp.Key))
                    lostAttacker[kvp.Key] += kvp.Value;
                else
                    lostAttacker[kvp.Key] = kvp.Value;
            }

            foreach (var kvp in round.DefendersRoundStatistics.GlobalUnitLostAmount)
            {
                if (lostDefender.ContainsKey(kvp.Key))
                    lostDefender[kvp.Key] += kvp.Value;
                else
                    lostDefender[kvp.Key] = kvp.Value;
            }
        }

        attackerAmount = BattleStatisticsService.BattleStatistics.GlobalAttackersAmount;
        defenderAmount = BattleStatisticsService.BattleStatistics.GlobalDefendersAmount;
    }

    public Task OnAttackerSelectChange(string? value){
        if(value == null) return Task.CompletedTask;

        if(value == "All"){
            PopulateUnits();
        }else{
            PopulateUnitsByAttacker(value);
        }

        _selectedAttackingPlayer = value;
        StateHasChanged();

        return Task.CompletedTask;
    }

    public Task OnDefenderSelectChange(string? value){
        if(value == null) return Task.CompletedTask;

        if(value == "All"){
            PopulateUnits();
        }else{
            PopulateUnitsByDefender(value);
        }

        _selectedDefendingPlayer = value;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task PopulateUnitsByAttacker(string coordinates){
        var player = BattleStatisticsService.BattleStatistics.Attackers
            .FirstOrDefault(x => x.Coordinates == coordinates);

        if(player == null) return Task.CompletedTask;

        attackerAmount = player.UnitAmount;
        lostAttacker = player.UnitLostAmount;

        return Task.CompletedTask;
    }

    private Task PopulateUnitsByDefender(string coordinates){
        var player = BattleStatisticsService.BattleStatistics.Defenders
            .FirstOrDefault(x => x.Coordinates == coordinates);

        if(player == null) return Task.CompletedTask;

        defenderAmount = player.UnitAmount;
        lostDefender = player.UnitLostAmount;

        return Task.CompletedTask;
    }
}
