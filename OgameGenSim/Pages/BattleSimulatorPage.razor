@page "/battleSimulator"

@namespace OgameGenSim.Pages

@using Microsoft.Extensions.Hosting
@using OgameGenSim.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using OgameGenSim.StateMachine
@using OgameSimulatorPack
@using OgameSimulatorPack.Classes
@using OgameGenSim.Classes
@using OgameGenSim.Services
@using OgameSimulatorPack.SimUtilities
@using RazorConsole.Components

@inject NavigationManager Nav
@inject Loader LoaderService 
@inject StateMachine<BSimState, BSimTrigger> BattleSimStateMachine
@inject OgameGenSim.Services.BattleStatisticsService BattleStatisticsService

<h3>BattleSimulatorPage</h3>

@if(BattleSimStateMachine.CurrentState == BSimState.FleetNumber){
    <Align>
        <TextInput Value="@_attackersNumber" ValueChanged="OnAttackersChanged" Label="Number of attackers"></TextInput>
        <TextInput Value="@_defendersNumber" ValueChanged="OnDefendersChanged" Label="Number of defenders"></TextInput>
        <FlexBox>
            <TextButton Content="Back" OnClick="@(() => Nav.NavigateTo("/"))"></TextButton>
            <TextButton Content="Next" OnClick="NextSimPage"></TextButton>
        </FlexBox>
    </Align>
}

@if(BattleSimStateMachine.CurrentState == BSimState.PlayerAPIs){
    <Align>
        @for(var i = 0; i < _attackersAPI.Count ; i++){
            var index = i;
            <TextInput Value="@_attackersAPI[i]" ValueChanged="@(value => OnAttackersAPIChanged(value, index))" Label="@("Attacker " + (i+1))"></TextInput>
        }

        @for(var i = 0; i < _defendersAPI.Count; i++){
            var index = i;
            <TextInput Value="@_defendersAPI[i]" ValueChanged="@(value => OnDefendersAPIChanged(value, index))" Label="@("Defender " + (i+1))"></TextInput>
        }

        <FlexBox>
            <TextButton Content="Back" OnClick="PreviousSimPage"></TextButton>
            <TextButton Content="Next" OnClick="NextSimPage"></TextButton>
        </FlexBox>
    </Align>
}

@if(BattleSimStateMachine.CurrentState == BSimState.MainFleetComposition){
    <Align>
        <MultiSelect @bind-Value="_selectedFleetComposition" Options="@fleetCompositionOptionsKeyValues"></MultiSelect>
        
        <CheckBox @bind-Value="_isAllCombinations" Label="Do all combinations"></CheckBox>

        @if(_isAllCombinations)
        {
            <CheckBox @bind-Value="_isAccountingSpeed" Label="Use speed to decide"></CheckBox>

            <FlexBox>
                <TextButton Content="Back" OnClick="PreviousSimPage"></TextButton>
                <TextButton Content="Next" OnClick="NextSimPage"></TextButton>
            </FlexBox>
        }else{
            <FlexBox>
                <TextButton Content="Back" OnClick="PreviousSimPage"></TextButton>
                <TextButton Content="Next" OnClick="NextSimPage"></TextButton>
            </FlexBox>
        }
    </Align>
}

@if(BattleSimStateMachine.CurrentState == BSimState.SecondaryFleetComposition){
    <Align>
        <CheckBox @bind-Value="_isStealCompositino" Label="Steal Only"></CheckBox>
        
        @if(_isStealCompositino)
        {
            <Select Options="cargoFleetTypes.Select(x => x.Value).ToArray()" 
                    Value="_stealCargoType" 
                    ValueChanged="@((string? value) => OnCargoUnitTypeChange(value))"></Select>


            <TextInput Value="@_stealUnitNumber" ValueChanged="OnStealUnitNumberChanged" Label="Number of units to send"></TextInput>
        
            <CheckBox @bind-Value="_isAllSmallCargosComposition" Label="Send all Small Cargos"></CheckBox>
            <CheckBox @bind-Value="_isAllLargeCargosComposition" Label="Send all Large Cargos"></CheckBox>
            <CheckBox @bind-Value="_isAllPathFindersComposition" Label="Send all PathFinders"></CheckBox>
            
            <Align>
                <p>Note* - Steal Only will send enough units to steal + 20% for losses</p>
                <p>Note** - Send all amounts will be adjusted by the simulator like any other fleet type</p>
                <p>Note*** - Send all [Type] will take priority over the Cargo type to steal</p>
            </Align>

            <FlexBox>
                <TextButton Content="Back" OnClick="PreviousSimPage"></TextButton>
                <TextButton Content="Next" OnClick="LoadPlayers"></TextButton>
            </FlexBox>
        }else{
            <CheckBox @bind-Value="_isAllSmallCargosComposition" Label="Send all Small Cargos"></CheckBox>
            <CheckBox @bind-Value="_isAllLargeCargosComposition" Label="Send all Large Cargos"></CheckBox>
            <CheckBox @bind-Value="_isAllPathFindersComposition" Label="Send all PathFinders"></CheckBox>

            <Align>
                <p>Note* - Steal Only will send enough units to steal + 20% for losses</p>
                <p>Note** - Send all amounts will be adjusted by the simulator like any other fleet type</p>
                <p>Note*** - Send all [Type] will take priority over the Cargo type to steal</p>
            </Align>
            
            <FlexBox>
                <TextButton Content="Back" OnClick="PreviousSimPage"></TextButton>
                <TextButton Content="Next" OnClick="LoadPlayers"></TextButton>
            </FlexBox>
        }
        
    </Align>
}

@code {
    private string _attackersNumber = string.Empty;
    private int attackersNumber = 0;
    private string _defendersNumber = string.Empty;
    private int defendersNumber = 0;
    private List<string> _attackersAPI = new List<string>();
    private List<string> _defendersAPI = new List<string>();
    public List<MainFleetComposition> _selectedFleetComposition = new();
    public bool _isAllCombinations = false;
    public bool _isAccountingSpeed = false;
    public bool _isStealCompositino = false;
    public string _stealUnitNumber = string.Empty;
    public int stealUnitNumber = 0;
    public string _stealCargoType = string.Empty;
    public UnitType stealCargoType = UnitType.SMALL_CARGO;
    public bool _isAllSmallCargosComposition = false;
    public bool _isAllLargeCargosComposition = false;
    public bool _isAllPathFindersComposition = false;

    private Dictionary<MainFleetComposition, string> fleetCompositionOptionsKeyValues = new (){
        {MainFleetComposition.RIPS, "RIPS"}, 
        {MainFleetComposition.SLOW_FLEET, "Slow Fleet"}, 
        {MainFleetComposition.FAST_FLEET, "Fast Fleet"}, 
        {MainFleetComposition.FODDER, "Fodder (fighters)"}, 
        {MainFleetComposition.FODDER2, "Fodder (probes)"},
        {MainFleetComposition.REAPER, "Reapers"}
    };

    private Dictionary<UnitType, string> cargoFleetTypes = new (){
        {UnitType.SMALL_CARGO, "Small Cargo"}, 
        {UnitType.LARGE_CARGO, "Large Cargo"}, 
        {UnitType.PATHFINDER, "Pathfinder"}, 
    };


    
    private void OnSelectCompositionChanged(List<MainFleetComposition> value){
        _selectedFleetComposition = value;
    }

    private void OnAttackersAPIChanged(string? value, int index){
        _attackersAPI[index] = value ?? string.Empty;
    } 

    private void OnDefendersAPIChanged(string? value, int index){
        _defendersAPI[index] = value ?? string.Empty;
    }

    private List<string> RecreateFleetApiList(int size){
        var newList = new List<string>();
        
        for(int i = 0; i < size; i++){
            newList.Add(string.Empty);
        }
        
        return newList;    
    }

    private Task OnAttackersChanged(string? value)
    {
        _attackersNumber = value ?? string.Empty;
        int.TryParse(_attackersNumber, out attackersNumber);

        _attackersAPI = RecreateFleetApiList(attackersNumber);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDefendersChanged(string? value)
    {
        _defendersNumber = value ?? string.Empty;   
        int.TryParse(_defendersNumber, out defendersNumber);  

        _defendersAPI = RecreateFleetApiList(defendersNumber);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnStealUnitNumberChanged(string? value)
    {
        _stealUnitNumber = value ?? string.Empty;
        int.TryParse(_stealUnitNumber, out stealUnitNumber);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnCargoUnitTypeChange(string? value)
    {
        _stealCargoType = value ?? string.Empty;

        var cargoTypeEnumType = cargoFleetTypes.FirstOrDefault(x => x.Value == _stealCargoType).Key;

        stealCargoType = cargoTypeEnumType;
        
        StateHasChanged();
        return Task.CompletedTask;
    }


    private async void LoadPlayers()
    {
        if(attackersNumber > 0 && defendersNumber > 0){
            DirtyCombatInformation dirtyData = await LoaderService.LoadCombatInformation(_attackersAPI, _defendersAPI);

            FleetComposition composition = new FleetComposition{
                MainFleetComposition = _selectedFleetComposition,
                IsAllCombinations = _isAllCombinations,
                IsAccountingSpeed = _isAccountingSpeed,
                SecondaryFleetComposition = new SecondaryFleetComposition{
                    IsStealComposition = _isStealCompositino,
                    CargoType = stealCargoType,
                    UnitNumber = stealUnitNumber,
                    IsAllSmallCargosComposition = _isAllSmallCargosComposition,
                    IsAllLargeCargosComposition = _isAllLargeCargosComposition,
                    IsAllPathFindersComposition = _isAllPathFindersComposition
                }
            };
            BattleStatisticsService.BestStatistics = BattleStatisticsService.DoBattles(composition, dirtyData, 10);

            Nav.NavigateTo("/battleStatistics");
        } 
    }

    private void NextSimPage(){
        var state = BattleSimStateMachine.ChangeState(BSimTrigger.Next);
        StateHasChanged();
        @* Console.WriteLine(state); *@
    }

    private void PreviousSimPage(){
        var state = BattleSimStateMachine.ChangeState(BSimTrigger.Previous);
        StateHasChanged();
        @* Console.WriteLine(state); *@
    }
}
