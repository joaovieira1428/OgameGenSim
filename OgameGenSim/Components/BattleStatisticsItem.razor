@namespace OgameGenSim.Components

@using OgameSimulatorPack.SimUtilities
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using RazorConsole.Components
@using System.Globalization

@foreach(var unit in GlobalPlayerAmount){
    <div>@unit.Key</div>
    <div>-@LostPlayerAmount[unit.Key].ToString("N0", numberFormat)</div>
    <div>: @unit.Value.ToString("N0", numberFormat)</div>
}

@code {
    private readonly NumberFormatInfo numberFormat = new NumberFormatInfo
    {
        NumberGroupSeparator = ".",
    };

    [Parameter]
    public Dictionary<UnitType, int> GlobalPlayerAmount {get;set;} = [];

    [Parameter]
    public Dictionary<UnitType, int> LostPlayerAmount {get;set;} = [];
}
