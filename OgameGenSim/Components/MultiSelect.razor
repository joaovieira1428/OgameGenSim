@using System.Security.AccessControl
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using RazorConsole.Components
@using Spectre.Console


@typeparam TEnum where TEnum : struct, Enum

@foreach(var item in Objects){
    <TextButton FocusedColor="Color.Blue" Content="@GetContentString(item)" OnClick="@( () => ToggleSelection(item))"></TextButton>
}
@code {
    [Parameter]
    public Dictionary<TEnum, string> Options { get; set; } = new();

    [Parameter]
    public List<TEnum> Value { get; set; } = new();

    [Parameter]
    public EventCallback<List<TEnum>> ValueChanged { get; set; }

    public List<MultiSelectObject> Objects = new();

    protected override void OnParametersSet()
    {
        Value ??= new();

        if (Options != default)
        {
            Objects = Options
                .Select(x => new MultiSelectObject { Key = x.Key, Content = x.Value, IsSelected = Value.Contains(x.Key) })
                .ToList();
        }
    }

    public class MultiSelectObject
    {
        public TEnum Key {get;set;}
        public string Content { get; set; } = "";
        public bool IsSelected { get; set; }
    }

    public string GetContentString(MultiSelectObject item)
    {
        return item.IsSelected ? $"[x]{item.Content}" : $"[]{item.Content}";
    }

    private async Task ToggleSelection(MultiSelectObject item)
    {
        item.IsSelected = !item.IsSelected;
        StateHasChanged();

        if (item.IsSelected)
            Value.Add(item.Key);
        else
            Value.Remove(item.Key);

        await ValueChanged.InvokeAsync(Value);
    }
}
